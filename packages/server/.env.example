# ChainDrop server configuration.
# Copy to `.env` for local work; on Railway these are set in the
# service's Variables tab instead.

# --- core -------------------------------------------------------------
PORT=2567
LOG_LEVEL=info
MAX_ROOMS=100

# Comma-separated. `*` allows any origin but then cookies will not be
# sent cross-site, so production must list the real client origin.
ALLOWED_ORIGINS=http://localhost:5173

# Signs the session cookie. MUST be set in production and MUST stay
# stable across restarts — a new value silently logs everyone out.
JWT_SECRET=

# `:memory:` starts empty on every boot. Production needs a path on a
# persistent volume, or every account disappears on redeploy.
DATABASE_PATH=:memory:

# Only set when the client and server share a parent domain.
# COOKIE_DOMAIN=

# --- Colyseus monitor -------------------------------------------------
MONITOR_ENABLED=false
MONITOR_USER=admin
MONITOR_PASS=

# --- Techmana SSO (テクマナ連携) ---------------------------------------
# Optional. With these unset the feature reports itself as disabled and
# the rest of the game runs normally.
#
# Register the client in Techmana's 管理 > 連携アプリ screen. The
# redirect URI must match byte-for-byte on both sides and must point at
# THIS server, not at the GitHub Pages client — the SPA has no router,
# so a callback path there would 404.
#
#   redirect_uri:     https://<this-server>/api/auth/techmana/callback
#   allowed_origins:  (leave blank)
#
# Leave the origin list empty. This server talks to Techmana server to
# server, so no CORS header is ever needed — and Techmana's CORS check
# is not scoped per client, so an origin registered here is opened for
# every client it has, not just this one.
#
TECHMANA_BASE_URL=https://techmana.adamant-group.jp
TECHMANA_CLIENT_ID=
TECHMANA_CLIENT_SECRET=
TECHMANA_REDIRECT_URI=

# Where the browser is sent after the Techmana round-trip. Must be the
# client's origin, since that is where the session cookie is used.
CLIENT_BASE_URL=https://dropdowner1.github.io/
